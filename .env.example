# Postgres database. For local dev the docker-compose Postgres works out of the
# box; for a hosted DB (e.g. Neon), paste the full connection string here.
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/v0-clone"

# ---------------------------------------------------------------------------
# Clerk authentication — grab these from https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Public app URL — used for SEO/OG metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Inngest — set to "1" to run against the local Inngest dev server
# (pnpm dlx inngest-cli dev). For production, set the Inngest Cloud keys:
# INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY.
# ---------------------------------------------------------------------------
INNGEST_DEV=1

# ---------------------------------------------------------------------------
# AI provider keys. These are the server-side defaults:
#  - OPENAI_API_KEY powers the default model (see DEFAULT_MODEL_ID in lib/models.ts)
#  - GEMINI_API_KEY powers the fragment title/response summary agents
# Anthropic/xAI don't need an env key: bring-your-own-key is handled per model in
# the in-app model selector and sent with the request.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
GEMINI_API_KEY=xxx

# E2B code-interpreter sandboxes — the build agent writes and runs code in these.
# Get a key from https://e2b.dev
E2B_API_KEY=e2b_xxx